APP_NAME="Forte Towing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Zona horaria del negocio (ajustar si aplica): America/New_York, America/Chicago, etc.
APP_TIMEZONE=America/New_York
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------
# BASE DE DATOS (MariaDB)
# Local (XAMPP): usuario root sin contraseña por defecto.
# Hostinger: usar el host, base de datos, usuario y contraseña que
# entrega el panel hPanel (Bases de datos MySQL). El driver "mysql"
# de Laravel es 100% compatible con MariaDB.
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=forte_towing
DB_USERNAME=root
DB_PASSWORD=
# Imprescindible para MariaDB (XAMPP e Hostinger): la colación por defecto
# de Laravel 11 (utf8mb4_0900_ai_ci) solo existe en MySQL 8.
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Poner en "true" solo en local para cargar vehículos de demostración
# con `php artisan migrate:fresh --seed`. En producción dejar en false.
SEED_DEMO_DATA=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En producción (Hostinger) configurar SMTP real desde hPanel:
# MAIL_MAILER=smtp, MAIL_HOST=smtp.hostinger.com, MAIL_PORT=465, etc.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-responder@fortetowing.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
