# ==================================================================
# Forte Towing — plantilla del .env de PRODUCCIÓN (Hostinger)
#
# Copiá este archivo como .env en el servidor y completá lo marcado
# con << >>. No subas nunca este archivo con datos reales al repo.
#
# Tras cualquier cambio acá, hay que recachear:
#   php artisan config:cache && php artisan route:cache
# ==================================================================

APP_NAME="Forte Towing"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<<tudominio.com>>

# Zona horaria del negocio.
APP_TIMEZONE=America/New_York

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# No bajar de 12: el hash del admin migrado desde la máquina local se
# creó con coste 12 y un coste menor lo rechazaría.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# En producción solo interesan los errores: "debug" llena el disco.
LOG_LEVEL=error

# ------------------------------------------------------------------
# BASE DE DATOS — hPanel › Bases de datos MySQL
# Hostinger prefija la base y el usuario con tu ID (u123456789_...).
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<<u000000000_forte>>
DB_USERNAME=<<u000000000_forte>>
DB_PASSWORD=<<contraseña de la base>>
DB_CHARSET=utf8mb4
# OBLIGATORIO: el valor por defecto de Laravel (utf8mb4_0900_ai_ci) solo
# existe en MySQL 8. Sin esta línea, las migraciones fallan en MariaDB.
DB_COLLATION=utf8mb4_unicode_ci

# ------------------------------------------------------------------
# SEGURIDAD
# ------------------------------------------------------------------
# Hosts aceptados en la cabecera Host, además de APP_URL y subdominios.
# Mientras el dominio propaga, sumá acá el de vista previa de Hostinger.
HOSTS_CONFIABLES=<<tudominio.com>>,www.<<tudominio.com>>

# Sin esto la cookie de sesión viaja sin marca Secure aunque el sitio
# sea HTTPS, y podría filtrarse por una petición en claro.
SESSION_SECURE_COOKIE=true

# Activar recién cuando el certificado esté emitido y estable: el
# navegador recuerda HSTS durante un año y revertirlo es lento.
FORZAR_HTTPS=false

# Sin SMTP no hay restablecimiento por correo: las rutas de
# /forgot-password no se registran y el enlace del login se oculta.
# El Admin cambia las contraseñas desde la pantalla de Usuarios.
RESET_PASSWORD_HABILITADO=false

# NUNCA en true en producción: sembraría vehículos de demostración y
# reescribiría las contraseñas de las cuentas de prueba.
SEED_DEMO_DATA=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No hay trabajos en cola ni worker corriendo. Con "sync", si algún día
# se agrega un job, se ejecuta en el momento en vez de quedar encolado
# para siempre sin que nadie lo note.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

# ------------------------------------------------------------------
# CORREO — desactivado a propósito (ver RESET_PASSWORD_HABILITADO).
# Si algún día querés activarlo: MAIL_MAILER=smtp, MAIL_HOST=smtp.hostinger.com,
# MAIL_PORT=465, MAIL_ENCRYPTION=ssl, y la casilla creada en hPanel.
# ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@<<tudominio.com>>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
