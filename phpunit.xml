<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- El idioma se fija aquí y no en el .env: sin esto, una máquina sin .env
             caería al default de config/app.php (inglés) y las pruebas fallarían. -->
        <env name="APP_LOCALE" value="es"/>
        <env name="APP_FALLBACK_LOCALE" value="es"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Las pruebas corren contra MariaDB (base separada), igual que producción. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="forte_towing_testing"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_CHARSET" value="utf8mb4"/>
        <env name="DB_COLLATION" value="utf8mb4_unicode_ci"/>
        <env name="SEED_DEMO_DATA" value="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- El mailer "array" apagaría las rutas de restablecer contraseña;
             se fuerzan encendidas para poder probar ese flujo. -->
        <env name="RESET_PASSWORD_HABILITADO" value="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
